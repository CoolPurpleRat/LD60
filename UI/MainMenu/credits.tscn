[sub_resource type="GDScript" id="GDScript_fpdaq"]
resource_name = "Credits"
script/source = "extends Panel

@onready var logoRef: RichTextLabel = %Logo2
@onready var creditsScrollRef: ScrollContainer = %CreditsScroll
@onready var vboxRef: VBoxContainer = $CreditsScroll/VBoxContainer

func _ready() -> void:
	await get_tree().process_frame
	for child in vboxRef.get_children():
		if child is FoldableContainer:
			child.connect(\"opened\", scrollTo)

func _onVisibilityChanged() -> void:
	if visible:
		logoRef.grab_focus.call_deferred()
		
##Scroll to start of container when opened
func scrollTo(container_position:Vector2)->void:
	await get_tree().process_frame
	creditsScrollRef.scroll_vertical=container_position.y
"

[sub_resource type="GDScript" id="GDScript_0ieht"]
resource_name = "creditsClick"
script/source = "extends RichTextLabel


func _on_meta_clicked(meta: Variant) -> void:
	OS.shell_open(meta)
"

