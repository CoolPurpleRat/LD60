[sub_resource type="GDScript" id="GDScript_agf74"]
resource_name = "screenShotList"
script/source = "extends Button

signal pressedButton(id:int)

var id:int=0

func _on_pressed() -> void:
	emit_signal(\"pressedButton\", id)

func setActive(isActive:bool=true)->void:
	if isActive:
		modulate=Color(1.0, 1.0, 1.0, 1.0)
	else:
		modulate=Color(1.0, 1.0, 1.0, 0.529)
"

